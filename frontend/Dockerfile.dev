FROM denoland/deno:alpine-2.9.3

WORKDIR /app

# Copy dependency files first for caching
COPY package.json deno.lock ./

# Install dependencies
RUN deno install --frozen

# Copy the rest of your frontend source code
COPY . .

EXPOSE 5173

ENV DEV_ENV=docker

# Vite needs --host to accept connections from the Caddy proxy
CMD ["deno", "task", "dev", "--", "--host", "0.0.0.0"]
