ADMIN_USER=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@test.com

POSTGRES_USER=${ADMIN_USER}
POSTGRES_PASSWORD=${ADMIN_PASSWORD}
POSTGRES_DB=portfolio_db

DB_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}

# DEV | PROD | TEST
DEPLOYMENT_MODE=DEV

BACKEND_SPOTIFY__CLIENT_ID=
BACKEND_SPOTIFY__CLIENT_SECRET=
BACKEND_SPOTIFY__REFRESH_TOKEN=

BACKEND_HARDCOVER__USER_ID=
BACKEND_HARDCOVER__API_TOKEN=

BACKEND_API__ALLOWED_ORIGINS=["*"]
BACKEND_API__ALLOWED_METHODS=["*"]
BACKEND_API__ALLOWED_HEADERS=["*"]

BACKEND_SECURITY__DEFAULT_RATE_LIMIT_PER_MINUTE=120
BACKEND_SECURITY__AUTH_RATE_LIMIT_PER_MINUTE=20
BACKEND_SECURITY__AUTO_BLACKLIST_MULTIPLIER=3
BACKEND_SECURITY__AUTO_BLACKLIST_MINUTES=30
# BACKEND_SECURITY__JWT_SECRET_KEY=
BACKEND_SECURITY__JWT_ALGORITHM=HS256
BACKEND_SECURITY__JWT_VIEWER_TOKEN_EXPIRE_MINUTES=30
BACKEND_SECURITY__JWT_ADMIN_TOKEN_EXPIRE_MINUTES=60

BACKEND_ADMIN__USER=${ADMIN_USER}
BACKEND_ADMIN__PASSWORD=${ADMIN_PASSWORD}
BACKEND_ADMIN__EMAIL=${ADMIN_EMAIL}
